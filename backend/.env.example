# TrustLayer Configuration Settings

# SQLite or PostgreSQL database URL
DATABASE_URL=sqlite:///./trustlayer.db

# Polygon Amoy Testnet RPC Endpoint
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Polygon Amoy Testnet Wallet Private Key (64-character hex key with testnet POL for live chain broadcasting)
# Optional: If left blank, TrustLayer operates in simulated testnet mode with PolygonScan tx links.
WALLET_PRIVATE_KEY=

# Optional Contract Address on Polygon Amoy
CONTRACT_ADDRESS=
